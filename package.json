{
  "name": "rulemate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "gen:components": "node scripts/convert-prototype.mjs \"design/Rulemate B2C.dc.html\" components",
    "deploy:dev": "npm run build && firebase deploy --only hosting --project dev",
    "deploy:prod": "npm run build && firebase deploy --only hosting --project prod"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "htmlparser2": "^10.1.0",
    "typescript": "5.9.3"
  }
}
