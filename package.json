{
  "name": "rulemate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "npm run build && firebase deploy --only hosting --project dev",
    "deploy:prod": "npm run build && firebase deploy --only hosting --project prod",
    "toss": "node --env-file-if-exists=.env.local server/toss-local.mjs",
    "toss:fake": "node server/fake-toss.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "htmlparser2": "^10.1.0",
    "typescript": "5.9.3"
  }
}
