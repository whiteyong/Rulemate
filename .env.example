# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Toss Securities Open API — issue at 토스증권 WTS(PC 웹) › 설정 › Open API.
# Used only by `npm run toss` (server/toss-local.mjs) on this computer.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# OpenDART (금융감독원 전자공시) — issue at opendart.fss.or.kr › 인증키 신청/관리.
# Optional: without it the bridge runs without disclosure (공시) alerts.
DART_API_KEY=
